# Generated by scripts/docsgen from assets/_headers — do not hand-edit in _site.
# Honorado por Cloudflare Pages y Netlify (GitHub Pages lo ignora).
# Cache-Control + seguridad para el sitio estático de go-pretty-pdf.

/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self' https://fonts.googleapis.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# HTML: revalidar siempre para que los cambios de docs se propaguen
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# PDFs / EPUBs (cambian solo en cada release): caché larga + revalidación en segundo plano
/go-pretty-pdf-docs-*.pdf
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/go-pretty-pdf-docs-*.epub
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/library-demo.pdf
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/full-demo.pdf
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Imágenes, iconos, manifest: seguros de cachear
/og-image.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, immutable
/favicon-32.png
  Cache-Control: public, max-age=86400, immutable
/icon-192.png
  Cache-Control: public, max-age=86400, immutable
/icon-512.png
  Cache-Control: public, max-age=86400, immutable
/favicon.svg
  Cache-Control: public, max-age=86400, immutable
/site.webmanifest
  Cache-Control: public, max-age=86400

# Texto / endpoints de máquinas y LLM: caché corta
/llms.txt
  Cache-Control: public, max-age=3600
/llms-full.txt
  Cache-Control: public, max-age=3600
/humans.txt
  Cache-Control: public, max-age=3600
/version.json
  Cache-Control: public, max-age=3600
